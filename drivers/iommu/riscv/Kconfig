# RISC-V IOMMU support

config RISCV_IOMMU
	bool "RISC-V IOMMU driver"
	depends on RISCV
	select IOMMU_API
	select IOMMU_DMA
	select IOMMU_IOVA
	select IOMMU_IO_PGTABLE
	help
	  Support for devices following RISC-V IOMMU specification.

	  If unsure, say N here.
