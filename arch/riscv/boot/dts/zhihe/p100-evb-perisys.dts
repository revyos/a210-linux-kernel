		};
	};
	usb31_pins: usb31-0 {
		usb31-pins {
			pins = "GPIO3_10";
			function = "usb31";
			bias-disable;
			drive-strength = <7>;
			input-enable;
			input-schmitt-enable;
			slew-rate = <0>;
		};
